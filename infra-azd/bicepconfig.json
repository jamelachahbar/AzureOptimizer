{
  "$schema": "https://schema.management.azure.com/schemas/2019-09-01/bicepconfig.json#",
  "experimentalFeaturesEnabled": {
    "extensibility": true,
    "extensionRegistry": true
  },
  "extensions": {
    "microsoftGraphV1_0": "br:mcr.microsoft.com/bicep/extensions/microsoftgraph/v1.0:1.0.0"
  },
  "moduleAliases": {
    "br": {
      "public": {
        "registry": "mcr.microsoft.com",
        "modulePath": "bicep"
      }
    }
  },
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        "no-unused-params": {
          "level": "warning"
        },
        "no-unused-vars": {
          "level": "warning"
        },
        "secure-secrets-in-params": {
          "level": "warning"
        },
        "use-recent-api-versions": {
          "level": "warning"
        }
      }
    }
  }
}
